#!/bin/bash
#
# manual - the Haliade OS manual
#
# A small, dependency-light pager for the Haliade OS documentation.
#
#   right / left    turn page (crosses section boundaries)
#   tab             open / close the sections menu
#   up / down       move the selection in the menu
#   enter           open the selected section
#   ctrl+c          quit
#
# Content is read from, in order of preference:
#
#   $MANUAL_DIR                               explicit override
#   <prefix>/share/manual                     /usr/share/manual when installed
#   <script dir>/content                      in-tree checkout
#
# Files inside the content directory:
#
#   cover.txt            the welcome screen, shown first
#   commands.txt         words rendered cyan wherever they appear
#   concepts.txt         important terms rendered yellow wherever they appear
#   NN-section.txt       a section; its menu name comes from the filename
#                        (02-definition.txt -> "Definition")
#
# Section text is folded to the terminal width and split into pages of the
# terminal height, so files are written as plain flowing text. Inside a
# section, {{markers}} render yellow, words listed in concepts.txt render
# yellow, words listed in commands.txt render cyan, and links and the Haliade
# name render blue. Commands win over concepts. Set NO_COLOR to turn the
# colour off.
#
# Environment:
#   MANUAL_DIR             content directory override
#   NO_COLOR               drop colour, keep bold and dim
#   MANUAL_RAIN=0          disable the welcome screen background
#   MANUAL_TRANSITION      random (default) | slide | matrix | type | off
#   MANUAL_TRACE=<file>    log each chosen transition - a testing hook

set -u

# --------------------------------------------------------------------------
# startup checks
# --------------------------------------------------------------------------

if [[ ! -t 0 || ! -t 1 ]]; then
    echo "manual: an interactive terminal is required" >&2
    exit 1
fi

for tool in tput fold; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "manual: missing required tool: $tool" >&2
        exit 1
    fi
done

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)

# MANUAL_DIR supersedes the old GUIDANCE_DIR name, which is still honoured.
content_root=${MANUAL_DIR:-${GUIDANCE_DIR:-}}

content_dir=""
for candidate in "$content_root" \
                 "$script_dir/../share/manual" \
                 "$script_dir/content"; do
    if [[ -n $candidate && -d $candidate ]]; then
        content_dir=$candidate
        break
    fi
done

if [[ -z $content_dir ]]; then
    echo "manual: no content directory found (looked in" \
         "\$MANUAL_DIR, $script_dir/../share/manual, $script_dir/content)" >&2
    exit 1
fi

cover_file=$content_dir/cover.txt
commands_file=$content_dir/commands.txt
concepts_file=$content_dir/concepts.txt

# --------------------------------------------------------------------------
# section discovery
# --------------------------------------------------------------------------

section_files=()
shopt -s nullglob
section_files=( "$content_dir"/[0-9]*.txt )
shopt -u nullglob

# sort -V keeps 01..10..11 in numeric order even with unpadded prefixes.
if (( ${#section_files[@]} > 0 )) && command -v sort >/dev/null 2>&1; then
    mapfile -t section_files < <(printf '%s\n' "${section_files[@]}" | sort -V)
fi

section_names=()
for file in "${section_files[@]}"; do
    base=${file##*/}
    base=${base%.txt}
    if [[ $base =~ ^[0-9]+-?(.*)$ ]]; then
        slug=${BASH_REMATCH[1]}
    else
        slug=$base
    fi
    [[ -z $slug ]] && slug=$base
    slug=${slug//-/ }
    section_names+=( "${slug^}" )
done

nsections=${#section_names[@]}

# --------------------------------------------------------------------------
# terminal capabilities
# --------------------------------------------------------------------------

C_BOLD=$(tput bold 2>/dev/null || true)
C_DIM=$(tput dim 2>/dev/null || true)
C_OFF=$(tput sgr0 2>/dev/null || true)

# Colour is optional: NO_COLOR, or a terminal without the capabilities, drops
# these to the empty string and the manual stays monochrome.
C_CMD=
C_LINK=
C_MARK=
C_BRAND=
C_CONCEPT=
C_BIND=
if [[ -z ${NO_COLOR:-} ]]; then
    C_CMD=$(tput setaf 6 2>/dev/null || true)
    # Links and markers carry bold too: on the Linux console base blue (4) and
    # base yellow (3) are the dark VGA variants, and bold sets the intensity
    # bit that turns them into the readable ones.
    C_LINK="$(tput setaf 4 2>/dev/null || true)$(tput bold 2>/dev/null || true)"
    C_MARK="$(tput setaf 3 2>/dev/null || true)$(tput bold 2>/dev/null || true)"
    # The Haliade name is the same readable blue as a link.
    C_BRAND=$C_LINK
    # Important terms take the same readable yellow as a {{highlight}}.
    C_CONCEPT=$C_MARK
    # Key binds take plain green: base green (2) is already bright enough on
    # its own, so unlike blue and yellow it needs no bold boost.
    C_BIND=$(tput setaf 2 2>/dev/null || true)
fi

# Parameter bytes of an escape sequence (e.g. ESC [ 1 ; 5 C) - used by read_key.
digit_or_semi='^[0-9;]$'
# Trailing punctuation that belongs to the sentence, not to a URL.
url_trail_re='[.,;:!?",)]$'
# Leading punctuation to peel off a word before looking it up.
word_lead_re='^(["([{]*)(.*)$'
# A key bind: a modifier followed by one or more "+ key" steps. Requiring the
# + is what keeps ordinary prose out - "better control about" and
# "(meta carries reserve_root)" contain modifiers but are not binds. POSIX ERE
# has no (?i), so each letter gets a class to allow Ctrl, CTRL and ctrl alike.
bind_mod='([Cc][Tt][Rr][Ll]|[Cc][Oo][Nn][Tt][Rr][Oo][Ll]|[Aa][Ll][Tt]|'
bind_mod+='[Ss][Hh][Ii][Ff][Tt]|[Ss][Uu][Pp][Ee][Rr]|[Mm][Ee][Tt][Aa]|'
bind_mod+='[Cc][Mm][Dd]|[Ww][Ii][Nn]|[Oo][Pp][Tt][Ii][Oo][Nn])'
bind_re="${bind_mod}([[:space:]]*[+][[:space:]]*[A-Za-z0-9]+)+"

# Absolute cursor addressing for the animation loop. Probed once so the
# background never forks a `tput` per row per frame: if the terminal reports
# the plain ANSI form - which every one we care about does - positions are
# printed with a literal format string, otherwise we fall back to tput.
cup_ansi=0
cup_probe=$(tput cup 0 0 2>/dev/null || true)
if [[ ${cup_probe//[0-9]/} == $'\e[;H' ]]; then
    cup_ansi=1
fi

# The background is opt-out, and it never runs on a serial console: a frame
# is about 2.2KB, and 115200 baud cannot carry seven of those a second.
rain_on() {
    case ${MANUAL_RAIN:-} in
        0 | off | no | false) return 1 ;;
    esac
    local name
    name=$(tty 2>/dev/null || true)
    [[ $name == /dev/ttyS* ]] && return 1
    return 0
}

# --------------------------------------------------------------------------
# command and concept vocabularies
# --------------------------------------------------------------------------

declare -A CMD_VOCAB=()
declare -A CONCEPT_VOCAB=()

# Read a vocabulary file into the array named by $2: one word per line,
# anything after # is a comment, matched case-insensitively. The remaining
# arguments are the fallback used when the file was not packaged, so the
# manual still renders styled instead of plain.
#
# shellcheck disable=SC2034  # dest is a nameref; writes land in the caller's
#                            # array, so shellcheck cannot see them used here
load_vocabulary() {
    local file=$1
    local -n dest=$2
    local word

    shift 2
    dest=()

    if [[ -f $file ]]; then
        while IFS= read -r word || [[ -n $word ]]; do
            word=${word%%#*}
            word=${word#"${word%%[![:space:]]*}"}       # trim left
            word=${word%"${word##*[![:space:]]}"}       # trim right
            [[ -z $word ]] && continue
            dest[${word,,}]=1
        done < "$file"
        return 0
    fi

    for word in "$@"; do
        dest[${word,,}]=1
    done
}

load_vocabulary "$commands_file" CMD_VOCAB \
    zstrappa zeta zeta-makepkg chronos iniswap genkernel nacelle \
    subspace-cli subspace-enter subspace-run subspace-sync \
    subspace-merge merged-packages-update thesh

load_vocabulary "$concepts_file" CONCEPT_VOCAB \
    declaration declarative declare declared definition subspaces houses \
    configure configuration config synchronizing generations swapping swap \
    isolate isolated merge merging helper module modules \
    generator generators plugin plugins nacelle spin repower constructs

COLS=80
ROWS=24
RULE=

measure() {
    COLS=$(tput cols 2>/dev/null || true)
    ROWS=$(tput lines 2>/dev/null || true)
    [[ $COLS =~ ^[0-9]+$ ]] || COLS=80
    [[ $ROWS =~ ^[0-9]+$ ]] || ROWS=24
    (( COLS < 20 )) && COLS=20
    printf -v RULE '%*s' "$COLS" ''
    RULE=${RULE// /-}
}

# --------------------------------------------------------------------------
# state
# --------------------------------------------------------------------------

state=cover          # cover | page
section=1            # 1-based
page=1               # 1-based
npages=1
pages=("(no content)")
menu_open=0
sel=1
resized=0
slide_dir=0          # -1 | 0 | 1, page-turn direction, consumed by render
body_rows=()         # the current page, split into lines, plain text

# page transitions
TRANS_POOL=(slide matrix type)
TRANS=""
TRANS_LAST=""        # so random never picks the same entrance twice running
BODY_DIM=0           # while an exit is fading, or a frame wants dim text
prev_rows=()         # the page on screen, for the exit to dissolve
EXIT_MASK=()         # per-turn erase mask, shared by exit and matrix entrance

# welcome screen background
RAIN_ENABLED=0
screen_init=1        # set again on resize or when leaving the cover
rain_tick=0
key_wait=0.25        # read_key poll interval, shortened while animating
screen_rows=()       # the screen buffer: plain characters, never escapes
cover_lines=()       # the folded cover text, cached per screen size
ov_col=() ov_text=() ov_style=()   # per-row overlays (cover lines, footer)
rain_head=()         # per column: row of the leading cell
rain_len=()          # per column: trail length
RAIN_ALPHABET='abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789'

# Styled output accumulates here. These are globals on purpose: colourise_text
# runs for every line of every frame, so it must never fork a subshell.
RL_PART=""
RL_OUT=""

# --------------------------------------------------------------------------
# pagination
# --------------------------------------------------------------------------

paginate() {
    local file=$1
    local body i
    local -a raw=()

    body=$(( ROWS - 4 ))
    (( body < 1 )) && body=1

    pages=()

    if [[ -f $file ]]; then
        mapfile -t raw < <(fold -s -w "$COLS" -- "$file")
    fi

    if (( ${#raw[@]} == 0 )); then
        pages=("(no content)")
        npages=1
        return 0
    fi

    for (( i = 0; i < ${#raw[@]}; i += body )); do
        pages+=( "$(printf '%s\n' "${raw[@]:i:body}")" )
    done

    npages=${#pages[@]}
}

load_section() {
    local idx=$1
    (( idx < 1 )) && idx=1
    (( idx > nsections )) && idx=$nsections
    section=$idx
    paginate "${section_files[$(( idx - 1 ))]}"
}

rebuild() {
    (( resized )) || return 0
    resized=0
    measure
    screen_init=1        # the buffer and the folded cover are sized to COLS/ROWS
    if [[ $state == page && $nsections -gt 0 ]]; then
        paginate "${section_files[$(( section - 1 ))]}"
        (( page > npages )) && page=$npages
        (( page < 1 )) && page=1
    fi
}

# --------------------------------------------------------------------------
# text styling
# --------------------------------------------------------------------------

# $RL_PART receives $1 fully colourised. Key binds are pulled out first and
# emitted whole, so no word inside a bind span can take another colour - the
# span wins. Everything else goes to colourise_tokens, one word at a time.
colourise_text() {
    local s=$1 pre m rest

    RL_PART=""

    while [[ $s =~ $bind_re ]]; do
        m=${BASH_REMATCH[0]}
        pre=${s%%"$m"*}
        rest=${s#*"$m"}
        # Reached only if the match does not survive being treated as a
        # literal; without this the loop could spin forever.
        [[ $rest == "$s" ]] && break
        colourise_tokens "$pre"
        RL_PART+="$C_BIND$m$C_OFF"
        s=$rest
    done

    colourise_tokens "$s"
}

# $RL_PART receives $1 with Haliade commands in cyan, the Haliade name and
# URLs in blue, and important terms in yellow. This appends to whatever is
# already there, because colourise_text calls it once per gap between binds.
# Token-exact matching, so /var/db/zeta/ and zeta-index stay plain while
# "zeta, zeta. and "zeta all resolve to the bare command.
colourise_tokens() {
    local s=$1 lead word core pre post tail

    while [[ $s =~ ^([[:space:]]*)([^[:space:]]+)(.*)$ ]]; do
        lead=${BASH_REMATCH[1]}
        word=${BASH_REMATCH[2]}
        s=${BASH_REMATCH[3]}

        RL_PART+=$lead

        case $word in
            http://* | https://*)
                tail=""
                while [[ $word =~ $url_trail_re ]]; do
                    tail=${word: -1}$tail
                    word=${word:0:$(( ${#word} - 1 ))}
                done
                if [[ -n $word ]]; then
                    RL_PART+="$C_LINK$word$C_OFF$tail"
                else
                    RL_PART+=$tail
                fi
                continue
                ;;
        esac

        core=$word
        pre=""
        post=""
        while [[ $core =~ $word_lead_re ]]; do
            [[ -n ${BASH_REMATCH[1]} ]] || break
            pre=${BASH_REMATCH[1]}$pre
            core=${BASH_REMATCH[2]}
        done

        # Peel trailing punctuation until the word ends in a letter, digit or
        # hyphen, so "Haliade's becomes Haliade and zeta, becomes zeta while
        # zeta-index and /etc/haliade/ keep their shape.
        while [[ -n $core && $core != *[A-Za-z0-9-] ]]; do
            post=${core: -1}$post
            core=${core:0:$(( ${#core} - 1 ))}
        done

        # The Haliade name goes blue, but haliade-synchronize is a command and
        # has to keep falling through to the cyan vocabulary below.
        case ${core,,} in
            haliade | haliadeos | os | gretagen)
                RL_PART+="$pre$C_BRAND$core$C_OFF$post"
                continue
                ;;
        esac

        # Commands win over concepts, so a word listed in both files stays
        # cyan. Reset before the trailing punctuation either way, or a closing
        # quote or comma would sit inside the attribute and get painted too.
        if [[ -n $core && -n ${CMD_VOCAB[${core,,}]+x} ]]; then
            RL_PART+="$pre$C_CMD$core$C_OFF$post"
        elif [[ -n $core && -n ${CONCEPT_VOCAB[${core,,}]+x} ]]; then
            RL_PART+="$pre$C_CONCEPT$core$C_OFF$post"
        else
            RL_PART+=$word
        fi
    done

    RL_PART+=$s
}

# $RL_OUT receives $1 with {{markers}} expanded and the rest colourised.
# The marker's colour wins, so a command inside a highlight stays yellow.
render_line() {
    local s=$1 before rest inner

    RL_OUT=""

    while [[ $s == *"{{"* ]]; do
        before=${s%%'{{'*}
        rest=${s#*'{{'}

        if [[ $rest =~ ^([^}]*)\}\}(.*)$ ]]; then
            inner=${BASH_REMATCH[1]}
            s=${BASH_REMATCH[2]}
            colourise_text "$before"
            RL_OUT+=$RL_PART
            RL_OUT+="$C_MARK$inner$C_OFF"
        else
            # Unterminated marker: show it literally rather than eat the line.
            colourise_text "$before{{"
            RL_OUT+=$RL_PART
            colourise_text "$rest"
            RL_OUT+=$RL_PART
            return 0
        fi
    done

    colourise_text "$s"
    RL_OUT+=$RL_PART
}

# --------------------------------------------------------------------------
# drawing
# --------------------------------------------------------------------------

clear_screen() {
    tput clear 2>/dev/null || printf '\033[2J'
    tput cup 0 0 2>/dev/null || true
}

# left-aligned $1 against right-aligned $2 on one line.
draw_split() {
    local left=$1 right=$2 lstyle=$3 rstyle=$4
    local avail gap

    avail=$(( COLS - ${#right} - 1 ))
    (( avail < 1 )) && avail=1
    (( ${#left} > avail )) && left=${left:0:avail}

    gap=$(( COLS - ${#left} - ${#right} ))
    (( gap < 1 )) && gap=1

    printf '%s%s%s%*s%s%s%s\n' \
        "$lstyle" "$left" "$C_OFF" "$gap" '' "$rstyle" "$right" "$C_OFF"
}

# Exactly $1 columns wide: truncated if too long, padded if too short.
fit() {
    local n=$1 t=$2
    (( ${#t} > n )) && t=${t:0:n}
    printf '%-*s' "$n" "$t"
}

# Print text without ever exceeding the terminal width - a line that runs past
# the right edge wraps and shoves everything below it down a row.
cap() {
    local t=$1
    (( ${#t} > COLS )) && t=${t:0:COLS}
    printf '%s' "$t"
}

draw_menu() {
    local inner=0 width top left need avail
    local i idx title hint_full hint_short placeholder
    local hint_text text content style bar frame nitems offset last

    title=" Sections "
    hint_full=" up/down move   enter open   tab close "
    hint_short=" up/down enter tab "
    placeholder=" (no sections yet) "
    hint_text=""

    # The box may never exceed the terminal width; anything that cannot fit is
    # left out of the width calculation and never drawn.
    avail=$(( COLS - 2 ))
    (( avail < 4 )) && avail=4

    if (( ${#hint_full} <= avail )); then
        hint_text=$hint_full
    elif (( ${#hint_short} <= avail )); then
        hint_text=$hint_short
    fi

    inner=${#title}
    (( ${#hint_text} > inner )) && inner=${#hint_text}
    if (( nsections == 0 )) && (( ${#placeholder} <= avail )) \
                           && (( ${#placeholder} > inner )); then
        inner=${#placeholder}
    fi
    for (( i = 0; i < nsections; i++ )); do
        need=$(( ${#section_names[i]} + 2 ))
        (( need > inner )) && inner=$need
    done
    (( inner > avail )) && inner=$avail

    width=$(( inner + 2 ))
    left=$(( (COLS - width) / 2 ))
    (( left < 0 )) && left=0

    printf -v bar '%*s' "$inner" ''
    bar=${bar// /-}

    # Section names (or the empty-menu placeholder), without selection markers.
    local -a items=()
    if (( nsections == 0 )); then
        items+=( "$placeholder" )
    else
        for (( i = 0; i < nsections; i++ )); do
            items+=( "${section_names[i]}" )
        done
    fi

    # Frame = top border + title + hint + bottom border. When the terminal is
    # too short the items shrink first, so both borders always stay visible.
    frame=3
    (( ${#hint_text} > 0 )) && frame=$(( frame + 1 ))
    nitems=${#items[@]}
    need=$(( ROWS - frame ))
    (( need < 0 )) && need=0
    (( nitems > need )) && nitems=$need

    # Slide the window down so the selection stays inside it.
    offset=0
    while (( nitems > 0 && sel > offset + nitems && offset + nitems < ${#items[@]} )); do
        offset=$(( offset + 1 ))
    done

    # Build the box as complete lines, escape sequences included, so the last
    # row can be printed without a newline: a newline on the bottom row of the
    # terminal scrolls the whole screen up a line.
    local -a box=()

    # | border | style | content (exactly $inner wide) | border | reset |
    box+=( "$(printf '%s+%s+%s' "$C_DIM" "$bar" "$C_OFF")" )

    content=$(fit "$inner" "$title")
    box+=( "$(printf '%s|%s%s%s%s|%s' "$C_DIM" "$C_BOLD" "$content" \
                                       "$C_OFF" "$C_DIM" "$C_OFF")" )

    for (( i = 0; i < nitems; i++ )); do
        idx=$(( offset + i ))
        text=${items[idx]}
        if (( nsections == 0 )); then
            style=$C_DIM
            content=$(fit "$inner" "$text")
        elif (( idx + 1 == sel )); then
            style=$C_BOLD
            content=$(fit "$inner" "> $text")
        else
            style=$C_DIM
            content=$(fit "$inner" "  $text")
        fi
        box+=( "$(printf '%s|%s%s%s%s|%s' "$C_DIM" "$style" "$content" \
                                           "$C_OFF" "$C_DIM" "$C_OFF")" )
    done

    if (( ${#hint_text} > 0 )); then
        content=$(fit "$inner" "$hint_text")
        box+=( "$(printf '%s|%s%s%s%s|%s' "$C_DIM" "$C_DIM" "$content" \
                                           "$C_OFF" "$C_DIM" "$C_OFF")" )
    fi
    box+=( "$(printf '%s+%s+%s' "$C_DIM" "$bar" "$C_OFF")" )

    # Last resort when the terminal is too short even for the frame.
    if (( ${#box[@]} > ROWS )); then
        box=( "${box[@]:0:ROWS}" )
        top=0
    else
        top=$(( (ROWS - ${#box[@]}) / 2 ))
        (( top < 0 )) && top=0
    fi

    last=$(( ${#box[@]} - 1 ))
    for (( i = 0; i <= last; i++ )); do
        tput cup $(( top + i )) "$left" 2>/dev/null || true
        if (( i < last )); then
            printf '%s\n' "${box[i]}"
        else
            printf '%s' "${box[i]}"
        fi
    done
}

# --------------------------------------------------------------------------
# welcome screen background
#
# The screen buffer holds plain characters and nothing else, so the rain can
# splice into it at absolute column offsets. All styling happens at emit time:
# that keeps colour out of the hot path entirely, and lets the cover sit on
# top of the rain without either layer disturbing the other.
# --------------------------------------------------------------------------

screen_start() {
    local r c

    screen_rows=()
    for (( r = 0; r < ROWS; r++ )); do
        printf -v screen_rows[r] '%*s' "$COLS" ''
    done

    rain_head=()
    rain_len=()
    for (( c = 0; c < COLS; c++ )); do
        rain_head[c]=$(( -(RANDOM % ROWS) ))
        rain_len[c]=$(( 4 + RANDOM % 5 ))
    done

    # Fold the cover once per screen size rather than once per frame: fold is
    # an external command and the background redraws seven times a second.
    cover_lines=()
    if [[ -f $cover_file ]]; then
        mapfile -t cover_lines < <(fold -s -w "$COLS" -- "$cover_file")
    else
        cover_lines=("manual: $cover_file not found")
    fi
    (( ${#cover_lines[@]} == 0 )) && cover_lines=("(empty manual)")

    screen_init=0
    (( RAIN_ENABLED )) && rain_advance
}

# One row of rain: advance every active column and rewrite its trail. Columns
# at odd offsets never move, which is what keeps this reading as background
# rather than a wall of text.
rain_advance() {
    local c j r s ch L h

    for (( c = 0; c < COLS; c += 2 )); do
        h=$(( rain_head[c] + 1 ))
        L=${rain_len[c]}

        # The cell the tail has just moved off has to go blank.
        r=$(( h - L ))
        if (( r >= 0 && r < ROWS )); then
            s=${screen_rows[r]}
            screen_rows[r]=${s:0:c}" "${s:c+1}
        fi

        for (( j = 0; j < L; j++ )); do
            r=$(( h - j ))
            if (( r < 0 || r >= ROWS )); then
                continue
            fi
            ch=${RAIN_ALPHABET:$(( RANDOM % ${#RAIN_ALPHABET} )):1}
            s=${screen_rows[r]}
            screen_rows[r]=${s:0:c}$ch${s:c+1}
        done

        # Respawn only once the whole trail has left the screen, so a column
        # never leaves a stump behind on its way out.
        if (( h - L >= ROWS )); then
            h=$(( -(RANDOM % ROWS) ))
            L=$(( 4 + RANDOM % 5 ))
        fi
        rain_head[c]=$h
        rain_len[c]=$L
    done
}

# Emit every row, addressed absolutely and with no newline anywhere: a newline
# on the last row would scroll the whole screen up a line. Each row comes out
# exactly COLS characters wide, so nothing the frame before drew can survive.
emit_screen() {
    local r raw col text st out

    for (( r = 0; r < ROWS; r++ )); do
        if (( cup_ansi )); then
            printf '\033[%d;%dH' $(( r + 1 )) 1
        else
            tput cup "$r" 0 2>/dev/null || true
        fi

        raw=${screen_rows[r]}

        if [[ -z ${ov_text[r]+set} ]]; then
            if (( RAIN_ENABLED )); then out="$C_DIM$raw$C_OFF"; else out=$raw; fi
            printf '%s' "$out"
            continue
        fi

        col=${ov_col[r]}
        text=${ov_text[r]}
        st=${ov_style[r]}
        (( ${#text} > COLS - col )) && text=${text:0:$(( COLS - col ))}

        # The parts either side of the cover are rain, so they take the dim
        # attribute; the cover text keeps the style compose_cover chose.
        out="${raw:0:col}"
        if (( RAIN_ENABLED )); then out="$C_DIM$out$C_OFF"; fi
        out+="$st$text$C_OFF"
        local tail=${raw:$(( col + ${#text} ))}
        if (( RAIN_ENABLED )); then out+="$C_DIM$tail$C_OFF"; else out+="$tail"; fi

        printf '%s' "$out"
    done
}

compose_cover() {
    local start i row line col style frow

    ov_col=()
    ov_text=()
    ov_style=()

    start=$(( (ROWS - ${#cover_lines[@]}) / 2 ))
    (( start < 0 )) && start=0

    i=0
    for line in "${cover_lines[@]}"; do
        row=$(( start + i ))
        (( row >= ROWS )) && break

        col=$(( (COLS - ${#line}) / 2 ))
        (( col < 0 )) && col=0
        (( col >= COLS )) && col=$(( COLS - 1 ))

        # Rain is the dimmest layer. The Braille rows contain no ASCII
        # letters, so the first line that does is the welcome message: art
        # sits at plain intensity above the rain, the message is bold above
        # that. Once the menu is up, everything steps back to dim.
        if (( menu_open )); then
            style=$C_DIM
        elif [[ $line =~ [A-Za-z] ]]; then
            style=$C_BOLD
        else
            style=""
        fi

        ov_col[row]=$col
        ov_text[row]=$line
        ov_style[row]=$style
        i=$(( i + 1 ))
    done

    # Composed last, so it replaces whatever the cover put on the bottom row -
    # the same order in which they used to be drawn directly.
    frow=$(( ROWS > 0 ? ROWS - 1 : 0 ))
    ov_col[frow]=0
    ov_text[frow]="  right: begin    tab: sections    ctrl+c: quit"
    if (( menu_open )); then
        ov_style[frow]=$C_DIM
    else
        ov_style[frow]=""
    fi
}

render_cover() {
    if (( screen_init )); then
        clear_screen
        screen_start
    fi
    compose_cover
    emit_screen
}

# --------------------------------------------------------------------------
# page transitions
#
# A page turn is two halves: trans_exit takes the old page off the screen, then
# one of the three entrances brings the new one on. Every frame writes each
# body row exactly COLS wide and never emits a newline on the terminal's last
# row, so no frame can leave residue behind or scroll the screen.
# --------------------------------------------------------------------------

# $1 = plain text for the next body row. Pads to the full width, which is what
# erases whatever the previous frame put there, then colourises and prints.
emit_body_row() {
    local out=$1

    printf -v out '%-*s' "$COLS" "$out"
    render_line "$out"

    if (( menu_open || BODY_DIM )); then
        printf '%s%s%s\n' "$C_DIM" "$RL_OUT" "$C_OFF"
    else
        printf '%s\n' "$RL_OUT"
    fi
}

# Horizontal shift at $1 columns - the original effect. Each row is written
# exactly COLS wide so a shifted frame leaves nothing of the frame before it,
# and the block is placed with a single cup so no newline can reach the last row.
draw_body() {
    local origin=$1 body=$2 i line out

    tput cup 2 0 2>/dev/null || true

    for (( i = 0; i < body; i++ )); do
        line=${body_rows[i]:-}

        if (( origin > 0 )); then
            printf -v out '%*s' "$origin" ''
            out+=${line:0:$(( COLS - origin ))}
        elif (( origin < 0 )); then
            out=${line:$(( -origin ))}
        else
            out=$line
        fi

        emit_body_row "$out"
    done
}

# --------------------------------------------------------------------------
# the exit: the page currently on screen has to leave before the next one can
# arrive. It fades to dim, half its letters erase themselves, then it is gone -
# three beats, so the new page follows an empty body instead of overwriting the
# old one mid-flight. It runs before clear_screen, so the page dissolves under
# its own header rather than under the new one.
# --------------------------------------------------------------------------
trans_exit() {
    local body=$1 r c line ch out
    local -a mask=()

    # Nothing on screen yet (the first page turn out of the cover).
    (( ${#prev_rows[@]} == 0 )) && return 0

    # One mask for both the exit and the matrix entrance, built once per turn.
    for (( r = 0; r < body; r++ )); do
        out=""
        for (( c = 0; c < COLS; c++ )); do
            out+=$(( RANDOM % 2 ))
        done
        mask[r]=$out
    done
    EXIT_MASK=("${mask[@]}")

    # beat 1: the page as it was, but fading
    BODY_DIM=1
    tput cup 2 0 2>/dev/null || true
    for (( r = 0; r < body; r++ )); do
        emit_body_row "${prev_rows[r]:-}"
    done
    sleep 0.02

    # beat 2: half its letters have erased themselves
    tput cup 2 0 2>/dev/null || true
    for (( r = 0; r < body; r++ )); do
        line=${prev_rows[r]:-}
        out=""
        for (( c = 0; c < COLS; c++ )); do
            ch=${line:c:1}
            if [[ -n $ch && $ch != " " && ${mask[r]:c:1} == 1 ]]; then
                out+=$ch
            else
                out+=" "
            fi
        done
        emit_body_row "$out"
    done
    sleep 0.02

    # beat 3: gone
    BODY_DIM=0
    tput cup 2 0 2>/dev/null || true
    for (( r = 0; r < body; r++ )); do
        emit_body_row ""
    done
}

# Typed in: the body is treated as one continuous stream of characters, so it
# fills left to right, top to bottom at roughly typing speed.
type_frame() {
    local budget=$1 body=$2 i line n

    tput cup 2 0 2>/dev/null || true

    for (( i = 0; i < body; i++ )); do
        line=${body_rows[i]:-}
        n=${#line}
        if (( budget >= n )); then
            emit_body_row "$line"
            budget=$(( budget - n - 1 ))      # -1 for the line break
        elif (( budget > 0 )); then
            emit_body_row "${line:0:budget}"
            budget=0
        else
            emit_body_row ""
        fi
    done
}

trans_slide() {
    local dir=$1 body=$2 step s prev=""

    step=$(( COLS / 8 ))
    (( step < 4 )) && step=4

    for s in "$step" "$(( step / 2 ))" 0; do
        [[ $s == "$prev" ]] && continue
        prev=$s
        draw_body $(( dir < 0 ? -s : s )) "$body"
        (( s == 0 )) || sleep 0.015
    done
}

trans_type() {
    local body=$1 total=0 i line budget prev=""

    for (( i = 0; i < body; i++ )); do
        line=${body_rows[i]:-}
        total=$(( total + ${#line} + 1 ))
    done

    for budget in "$(( (total + 2) / 3 ))" "$(( (total * 2 + 2) / 3 ))" "$total"; do
        [[ $budget == "$prev" ]] && continue
        prev=$budget
        type_frame "$budget" "$body"
        (( budget >= total )) || sleep 0.02
    done
}

# Matrix entrance: cells decode in over two beats. The mask the exit used to
# erase letters is reused, so the letters that vanished come back first.
# Cells carrying no text stay blank rather than filling the margins with noise.
trans_matrix() {
    local body=$1 frame r c line ch th out
    local -a mask=()

    if (( ${#EXIT_MASK[@]} == body )); then
        mask=("${EXIT_MASK[@]}")
    else
        for (( r = 0; r < body; r++ )); do
            out=""
            for (( c = 0; c < COLS; c++ )); do
                out+=$(( RANDOM % 2 ))
            done
            mask[r]=$out
        done
    fi
    EXIT_MASK=()

    for frame in 0 1; do
        tput cup 2 0 2>/dev/null || true
        for (( r = 0; r < body; r++ )); do
            line=${body_rows[r]:-}
            out=""
            for (( c = 0; c < COLS; c++ )); do
                ch=${line:c:1}
                if [[ -z $ch || $ch == " " ]]; then
                    out+=" "
                    continue
                fi
                th=${mask[r]:c:1}
                if (( th <= frame )); then
                    out+=$ch
                else
                    out+=${RAIN_ALPHABET:$(( RANDOM % ${#RAIN_ALPHABET} )):1}
                fi
            done
            emit_body_row "$out"
        done
        (( frame == 1 )) || sleep 0.015
    done
}

# Choose the effect for this page turn. MANUAL_TRANSITION pins one, "off"
# restores an instant redraw, and random never repeats itself twice running.
pick_transition() {
    local mode=${MANUAL_TRANSITION:-random} idx guard

    case $mode in
        off | none) TRANS=""
                    TRANS_LAST=""
                    return 0
                    ;;
        random)     ;;
        *)          TRANS=$mode
                    return 0
                    ;;
    esac

    guard=0
    while :; do
        idx=$(( RANDOM % ${#TRANS_POOL[@]} ))
        TRANS=${TRANS_POOL[idx]}
        [[ $TRANS != "$TRANS_LAST" ]] && break
        guard=$(( guard + 1 ))
        (( guard > 16 )) && break     # pool of one: accept the repeat
    done
    TRANS_LAST=$TRANS

    if [[ -n ${MANUAL_TRACE:-} ]]; then
        printf '%s\n' "$TRANS" >> "$MANUAL_TRACE"
    fi
}

# The entrance half of a page turn. TRANS has already been chosen by
# pick_transition, which also decided whether an exit happens at all.
run_enter() {
    local dir=$1 body=$2

    BODY_DIM=0
    case $TRANS in
        slide)  trans_slide  "$dir" "$body" ;;
        matrix) trans_matrix "$body" ;;
        type)   trans_type   "$body" ;;
        *)      draw_body 0 "$body" ;;
    esac

    BODY_DIM=0
}

render_page() {
    local dir=$1 body show_tail=0 name text

    body=$(( ROWS - 4 ))
    (( body < 1 )) && body=1
    (( ROWS >= body + 4 )) && show_tail=1

    # Pick the entrance first: with MANUAL_TRANSITION=off there is no entrance
    # and therefore no exit either, and the page just redraws.
    EXIT_MASK=()
    if (( dir != 0 )); then
        pick_transition
    fi

    name="(untitled)"
    text=""
    if (( section >= 1 && section <= nsections )); then
        name=${section_names[$(( section - 1 ))]}
    fi
    if (( page >= 1 && page <= npages )); then
        text=${pages[$(( page - 1 ))]}
    fi

    # The outgoing page dissolves while its own header is still up; only once
    # it is gone does the screen get wiped and the new header go on.
    if (( dir != 0 )) && [[ -n $TRANS ]]; then
        trans_exit "$body"
    fi

    clear_screen

    draw_split "Haliade OS manual - $name" "page $page/$npages" "$C_BOLD" "$C_DIM"
    printf '%s%s%s\n' "$C_DIM" "$RULE" "$C_OFF"

    mapfile -t body_rows <<<"$text"
    if (( dir != 0 )); then
        run_enter "$dir" "$body"
    else
        draw_body 0 "$body"
    fi

    if (( show_tail )); then
        tput cup $(( ROWS - 2 )) 0 2>/dev/null || true
        printf '%s%s%s\n' "$C_DIM" "$RULE" "$C_OFF"
        tput cup $(( ROWS - 1 )) 0 2>/dev/null || true
        printf '%s%s%s' "$C_DIM" \
            "$(cap '  left/right: turn page    tab: sections    ctrl+c: quit')" \
            "$C_OFF"
    fi

    # Remember what is on screen so the next turn has something to dissolve.
    prev_rows=("${body_rows[@]}")
}

render() {
    local dir=$slide_dir
    slide_dir=0

    rebuild
    if [[ $state == cover ]]; then
        render_cover
    else
        # Leaving the cover invalidates the buffer: the page screen has
        # taken over, so the next welcome screen must be rebuilt from scratch.
        screen_init=1
        render_page "$dir"
    fi
    # The sections menu overlays whichever screen is showing - the cover
    # invites the user to press TAB, so it has to work there too.
    if (( menu_open )); then
        draw_menu
    fi
    tput cup $(( ROWS > 0 ? ROWS - 1 : 0 )) 0 2>/dev/null || true
}

# --------------------------------------------------------------------------
# input
# --------------------------------------------------------------------------

REPLY=""

# Sets REPLY to ENTER / TAB / UP / DOWN / LEFT / RIGHT / ESC / <char>,
# or to the empty string when no key arrived (timeout, signal, EOF).
read_key() {
    local k="" rest="" fin="" next="" guard st

    REPLY=""

    # The timeout doubles as a poll: it picks up resizes on terminals where
    # bash restarts read() after the WINCH trap, and it is what the welcome
    # screen animates on - short while the background runs, so a keypress is
    # answered inside one frame.
    IFS= read -rsn1 -t "$key_wait" k
    st=$?
    if (( st != 0 )); then
        # status 1 means the input stream ended - back off rather than spin.
        (( st == 1 )) && sleep 0.25
        return 0
    fi

    if [[ -z $k ]]; then REPLY="ENTER"; return 0; fi
    if [[ $k == $'\t' ]]; then REPLY="TAB"; return 0; fi
    if [[ $k != $'\e' ]]; then REPLY=$k; return 0; fi

    if ! IFS= read -rsn1 -t 0.05 rest; then REPLY="ESC"; return 0; fi
    if [[ $rest != '[' && $rest != 'O' ]]; then REPLY="ESC"; return 0; fi
    if ! IFS= read -rsn1 -t 0.05 fin; then REPLY="ESC"; return 0; fi

    # Modified arrows arrive as ESC [ 1 ; 5 C - drain to the final byte.
    guard=0
    while [[ $fin =~ $digit_or_semi ]] && (( guard < 8 )); do
        if ! IFS= read -rsn1 -t 0.05 next; then
            REPLY=""
            return 0
        fi
        fin=$next
        guard=$(( guard + 1 ))
    done

    case $fin in
        A) REPLY="UP" ;;
        B) REPLY="DOWN" ;;
        C) REPLY="RIGHT" ;;
        D) REPLY="LEFT" ;;
        *) REPLY="" ;;
    esac
}

# --------------------------------------------------------------------------
# navigation
# --------------------------------------------------------------------------

begin() {
    (( nsections == 0 )) && return 0
    state=page
    load_section 1
    page=1
}

turn_page() {
    local dir=$1

    if [[ $state == cover ]]; then
        if (( dir > 0 && nsections > 0 )); then
            begin
            slide_dir=$dir
        fi
        return 0
    fi
    (( nsections == 0 )) && return 0

    if (( dir > 0 )); then
        if (( page < npages )); then
            page=$(( page + 1 ))
            slide_dir=$dir
        elif (( section < nsections )); then
            load_section $(( section + 1 ))
            page=1
            slide_dir=$dir
        fi
    else
        if (( page > 1 )); then
            page=$(( page - 1 ))
            slide_dir=$dir
        elif (( section > 1 )); then
            load_section $(( section - 1 ))
            page=$npages
            slide_dir=$dir
        else
            state=cover       # back out to the welcome screen
        fi
    fi
}

handle_key() {
    local k=$REPLY

    [[ -z $k ]] && return 0

    if (( menu_open )); then
        case $k in
            TAB | ESC) menu_open=0 ;;
            UP)        (( sel > 1 )) && sel=$(( sel - 1 )) ;;
            DOWN)      (( sel < nsections )) && sel=$(( sel + 1 )) ;;
            ENTER)
                menu_open=0
                if (( nsections > 0 )); then
                    state=page
                    load_section "$sel"
                    page=1
                fi
                ;;
        esac
        return 0
    fi

    case $k in
        RIGHT) turn_page 1 ;;
        LEFT)  turn_page -1 ;;
        ENTER) [[ $state == cover ]] && begin ;;
        TAB)
            menu_open=1
            if (( nsections > 0 )); then
                sel=$section
            else
                sel=1
            fi
            ;;
    esac
}

# --------------------------------------------------------------------------
# teardown
# --------------------------------------------------------------------------

saved_stty=$(stty -g 2>/dev/null || true)
cleaned=0

cleanup() {
    (( cleaned )) && return 0
    cleaned=1
    [[ -n $saved_stty ]] && stty "$saved_stty" 2>/dev/null
    tput cnorm 2>/dev/null
    tput sgr0 2>/dev/null
    tput clear 2>/dev/null
    return 0
}

trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM
trap 'cleanup; exit 129' HUP
trap 'resized=1' WINCH

# --------------------------------------------------------------------------
# main loop
# --------------------------------------------------------------------------

measure

# Testing hook: MANUAL_TRACE records which transition each page turn picked,
# so the "never the same twice" rule is assertable. Fresh file per run.
if [[ -n ${MANUAL_TRACE:-} ]]; then
    : > "$MANUAL_TRACE"
fi

if rain_on; then
    RAIN_ENABLED=1
fi

if (( nsections > 0 )); then
    load_section 1
fi

tput civis 2>/dev/null || :

render

while true; do
    if (( RAIN_ENABLED )) && [[ $state == cover ]]; then
        key_wait=0.07
    else
        key_wait=0.25
    fi

    read_key

    if (( resized )); then
        render
        continue
    fi

    if [[ -z $REPLY ]]; then
        # Idle on the welcome screen: keep the background moving. Two polls
        # per row, so the rain drifts at 140ms a row while a keypress is
        # still answered inside 70ms.
        if (( RAIN_ENABLED )) && [[ $state == cover ]]; then
            rain_tick=$(( rain_tick + 1 ))
            if (( rain_tick % 2 == 0 )); then
                rain_advance
                render
            fi
        fi
        continue
    fi

    handle_key
    render
done
